{
  "manifest_version": 3,
  "name": "LifeShield",
  "version": "1.0.0",
  "description": "LifeShield browser collector — monitors URL visits, redirects, and downloads and sends them to the local LifeShield agent.",

  "permissions": [
    "tabs",
    "webNavigation",
    "downloads",
    "storage"
  ],

  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
